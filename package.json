{
  "name": "@rizkifirmansyah/n8n-nodes-instagram-api",
  "version": "0.2.3",
  "description": "n8n community node for Instagram API with Instagram Login (Business Login for Instagram) & AI Agent Tool",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "instagram",
    "instagram-api",
    "instagram-login",
    "meta",
    "business-login",
    "ai-tool",
    "ai-agent"
  ],
  "license": "MIT",
  "author": {
    "name": "Rizki Firmansyah",
    "email": "firmansyah720.fs@gmail.com"
  },
  "homepage": "https://github.com/legenhand/n8n-nodes-instagram-api",
  "repository": {
    "type": "git",
    "url": "https://github.com/legenhand/n8n-nodes-instagram-api.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/InstagramApi.credentials.js",
      "dist/credentials/InstagramOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Instagram/Instagram.node.js"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsc && mkdir -p dist/nodes/Instagram dist/credentials && cp nodes/Instagram/*.svg nodes/Instagram/*.json dist/nodes/Instagram/ && cp credentials/*.svg dist/credentials/",
    "dev": "tsc --watch",
    "docs:dev": "bun --cwd docs dev",
    "docs:build": "bun --cwd docs build",
    "docs:preview": "bun --cwd docs preview"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.45.4",
    "@types/node": "^20.17.19",
    "n8n-workflow": "^1.78.0",
    "typescript": "^5.7.3"
  }
}
